# see https://clangd.llvm.org/config#if
If:
    PathMatch: *

# see https://clangd.llvm.org/config#compileflags
CompileFlags:
    Add:

CompileFlags:
  Add:
    # include paths are set in `CMakeLists.txt`
    - -DARDUINO_ESP32_DEV
    - -DARDUINO_ARCH_ESP32
    - -DARDUINO_BOARD="ESP32_DEV"
    - -DESP32
